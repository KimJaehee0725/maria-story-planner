{
  "name": "mbeatshit-drama-planner",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server.js",
    "dev:server:spark": "OPENAI_BASE_URL=http://127.0.0.1:18000/v1 OPENAI_API_KEY=sk-local OPENAI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8 npm run dev:server",
    "start": "node server.js",
    "start:spark": "OPENAI_BASE_URL=http://127.0.0.1:18000/v1 OPENAI_API_KEY=sk-local OPENAI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8 npm start",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:spark": "curl -sS http://127.0.0.1:18000/v1/models",
    "check": "node --check server.js && node --check data-model.js && node --check scripts/model-contract-test.js && node --check scripts/backend-smoke-test.js && node --check scripts/prepare-e2e-storage.js && tsc -p tsconfig.json",
    "test:model": "node scripts/model-contract-test.js",
    "test:backend": "node scripts/model-contract-test.js && node scripts/backend-smoke-test.js",
    "test:e2e": "node scripts/prepare-e2e-storage.js && playwright test",
    "test:frontend": "npm run test:e2e"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.28",
    "busboy": "^1.6.0",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
